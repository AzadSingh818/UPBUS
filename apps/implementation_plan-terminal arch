## Standardized Production Log Item Schema

```typescript
export interface ProductionLogItem {
  timestamp: string;
  terminalId: 'engine' | 'admin' | 'webapp' | 'gateway';
  service: string; // GEO-MATCH, KALMAN-FLT, MAP-MATCH, ETA-ENGINE, AUTH, SCHEDULER, API, FARE-ENGINE
  level: 'INFO' | 'DEBUG' | 'WARN' | 'ERROR' | 'CRIT';
  entityId?: string; // VEHICLE_ID, TRIP_ID, ADMIN_ID, SESSION_ID
  message: string;
  latencyMs?: number;
  details?: string;
}
```

